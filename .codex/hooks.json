{
  "description": "Engineering Guard policy delivery and pre-write gates.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/testing_guard.py\"",
            "commandWindows": "py -3 -c \"import pathlib,runpy,subprocess;runpy.run_path(str(pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'.codex/hooks/testing_guard.py'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/testing_guard.py\"",
            "commandWindows": "py -3 -c \"import pathlib,runpy,subprocess;runpy.run_path(str(pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'.codex/hooks/testing_guard.py'))\"",
            "timeout": 5,
            "statusMessage": "Checking Engineering Guard policies"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/testing_guard.py\"",
            "commandWindows": "py -3 -c \"import pathlib,runpy,subprocess;runpy.run_path(str(pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip())/'.codex/hooks/testing_guard.py'))\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
